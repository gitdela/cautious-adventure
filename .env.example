# ---------------------------------------------------------------------------
# PETROSOL monorepo — env var reference
#
# This file DOCUMENTS every env var, per surface. It is never loaded directly:
# each app resolves its own env source through @workspace/config, which
# validates values and fails hard on a misconfigured production build.
#
#   apps/website  → copy the website block into apps/website/.env.local
#   apps/studio   → copy the studio block into apps/studio/.env.local
#
# Future surfaces (reserved seams — nothing reads these yet):
#   apps/webapp   → VITE_* variants of the public vars
#   apps/api      → API_* / server-only config
# ---------------------------------------------------------------------------

# ============================= apps/website ================================
# `NEXT_PUBLIC_*` values are inlined into the client bundle at build time.

# Public origin of the marketing website itself.
#   local:  http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Reserved seams — resolved by @workspace/config but unused until the
# webapp/api surfaces exist. Safe to leave unset in development (falls back
# to localhost); required for production builds of code that calls them.
#NEXT_PUBLIC_WEBAPP_URL=http://localhost:5174
#NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Sanity (public — project id / dataset / API version ship in the bundle).
#   dataset: development (local) | production (deployed)
NEXT_PUBLIC_SANITY_PROJECT_ID=3tmnavlv
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Sanity SERVER-ONLY secrets — never NEXT_PUBLIC_*, never in the browser.
# Set in the deploy secret manager; leave blank locally unless working on
# draft preview / revalidation.
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=

# Cloudflare Turnstile — spam gate on the /contact form.
# Public site key. Left unset in development it falls back to Cloudflare's
# "always passes" test key, so the form works with no Cloudflare account.
# A production build with this unset throws rather than ship the test key.
#NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SERVER-ONLY secret. Must be the pair of the site key above — test secret
# 1x0000000000000000000000000000000AA matches test site key 1x00000000000000000000AA.
# Test secrets reject real tokens and vice versa, so never mix the two.
TURNSTILE_SECRET_KEY=

# Resend — delivers contact-form submissions. All SERVER-ONLY.
# CONTACT_FROM_EMAIL's domain must exactly match a Resend-verified domain.
# Until DNS is configured use the sandbox sender `onboarding@resend.dev`,
# which only delivers to your own Resend account address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# ============================== apps/studio ================================
# Only the SANITY_STUDIO_* prefix is exposed to the Studio bundle (Vite).
SANITY_STUDIO_PROJECT_ID=3tmnavlv
SANITY_STUDIO_DATASET=development
SANITY_STUDIO_API_VERSION=2026-07-01
