# Sanity Studio env template for apps/studio.
#
# The Sanity CLI auto-loads these from `.env` / `.env.local`. Only the
# `SANITY_STUDIO_*` prefix is exposed to the Studio bundle. These are public
# (project ID / dataset / API version) — no secrets belong here.
#
# Copy to `.env.local` for local Studio work. Create the project first with
# `bunx sanity@latest init` (or in sanity.io/manage), then paste its ID here.
#   dataset:  development (default for local schema/content iteration)

SANITY_STUDIO_PROJECT_ID=3tmnavlv
SANITY_STUDIO_DATASET=development
SANITY_STUDIO_API_VERSION=2026-07-01
