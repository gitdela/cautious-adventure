{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "start": "sanity start",
    "schema:extract": "sanity schema extract --enforce-required-fields --path ../../packages/cms/src/generated/schema.json",
    "typegen": "sanity typegen generate",
    "validate": "sanity documents validate -y",
    "seed:generate": "bun run seed/generate.ts",
    "seed:dev": "sanity dataset import seed/seed.ndjson --dataset development --replace",
    "lubricants:import": "bun run seed/lubricants-import.ts",
    "fuel:import": "bun run seed/fuel-import.ts",
    "stations:import": "bun run seed/stations-import.ts",
    "stations:region:backfill": "sanity exec seed/stations-region-backfill.ts --with-user-token",
    "gallery:import": "bun run seed/gallery-import.ts",
    "blog:import": "bun run seed/blog-import.ts",
    "blog:titles": "bun run seed/blog-titles.ts"
  },
  "dependencies": {
    "@sanity/vision": "6.5.0",
    "@workspace/cms": "workspace:*",
    "@workspace/config": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanity": "6.5.0",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@sanity/cli": "6.5.0",
    "@sanity/client": "7.23.2",
    "@types/react": "^19.2.14",
    "typescript": "~6.0.2"
  }
}
